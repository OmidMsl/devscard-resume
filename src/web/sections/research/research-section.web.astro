---
import type { ResearchSection } from '@/types/sections/research-section.types';
import Divider from '@/web/components/divider.astro';
import SectionCard from '@/web/components/section-card.astro';
import ResearchItem from './research-item.astro';

export interface Props extends ResearchSection {}

const { config, researches } = Astro.props;
---

<SectionCard {...config}>
  {researches.flatMap((research) => [<ResearchItem {...research} />, <Divider />])}
</SectionCard>
