---
import type { ResearchSection } from '@/types/sections/research-section.types';
import Description from '../components/description.astro';
import LabelledValue from '../components/labelled-value.astro';
import ListItemHeading from '../components/list-item-heading.astro';
import SectionHeading from '../components/section-heading.astro';
import TagsList from '../components/tags-list.astro';

export interface Props extends ResearchSection {}

const { config, researches } = Astro.props;
---

<div>
  <SectionHeading>{config.title}</SectionHeading>
  <div class="flex flex-col">
    {researches.map(({ title, researchTitle, dates, details, description, keywords }) => (
      <div class="flex flex-col gap-2">
        <ListItemHeading title={researchTitle} dates={dates ?? [new Date(0), null]} />
        <div class="text-base font-semibold text-gray-700">{title}</div>
        <Description content={description} />
        <div class="flex flex-col gap-1">
          {details.map((detail) => (
            <LabelledValue {...detail} />
          ))}
        </div>
        <TagsList {...keywords} />
      </div>
    ))}
  </div>
</div>
