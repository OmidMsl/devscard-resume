<style is:global>
  /* Load Persian webfont placed under public/fonts/iran-sans. Must be imported
     before other @font-face rules to satisfy Vite/CSS ordering. */
  @import url('/fonts/iran-sans/iran-sans.css');

  @font-face {
    font-family: 'Inter var';
    font-weight: 100 900;
    font-display: swap;
    font-style: normal;
    font-named-instance: 'Regular';
    src: url('/fonts/Inter-roman.var.woff2') format('woff2');
  }
</style>
