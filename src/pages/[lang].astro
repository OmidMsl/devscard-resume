---
import Layout from '@/web/components/layout.astro';
import Sidebar from '@/web/components/sidebar.astro';
import ThemeToggle from '@/web/components/theme-toggle.astro';
import MainSection from '@/web/sections/main/main-section.web.astro';
import SkillsSection from '@/web/sections/skills/skills-section.web.astro';
import ExperienceSection from '@/web/sections/experience/experience-section.web.astro';
import PortfolioSection from '@/web/sections/portfolio/portfolio-section.web.astro';
import ResearchSection from '@/web/sections/research/research-section.web.astro';
import EducationSection from '@/web/sections/education/education-section.web.astro';
import { getLocalizedCvData } from '@/data';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fa' } }];
}

const { lang } = Astro.params;
const locale = lang === 'fa' ? 'fa' : 'en';
const data = getLocalizedCvData(locale)();
const { config, sections } = data;
const switchHref = locale === 'en' ? '/fa' : '/en';
const switchLabel = locale === 'en' ? 'فارسی' : 'English';
const bodyClass = locale === 'fa' ? 'font-[sans-serif]' : '';
---

<Layout {...config} sections={sections}>
  <!-- For Persian (`/fa`) apply a system sans-serif stack and avoid forcing full-width
       so the parent `body` flex centering in `layout.astro` can center the content. -->
  <div
    class={locale === 'fa' ? 'font-sans' : ''}
    style={
      locale === 'fa'
        ? "font-family: 'IranSans', 'IranSansFaNum', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;"
        : undefined
    }
  >
    <div class="w-full max-w-5xl mx-auto px-2 py-3 sm:px-8 sm:py-12 lg:py-20">
    <div class="mb-4 flex justify-end">
      <a
        href={switchHref}
        class="rounded-full border border-gray-300 px-3 py-1 text-sm font-medium text-gray-700 transition hover:border-gray-400 hover:text-gray-900 dark:border-gray-700 dark:text-gray-200 dark:hover:border-gray-600 dark:hover:text-white"
      >
        {switchLabel}
      </a>
    </div>
    <div class="flex w-full flex-col gap-4 lg:flex-row lg:items-start">
      <main class="w-full max-w-5xl space-y-4 sm:space-y-6 lg:space-y-8">
        <MainSection {...sections.main} />
        <SkillsSection {...sections.skills} />
        <ExperienceSection {...sections.experience} />
        <PortfolioSection {...sections.portfolio} />
        <ResearchSection {...sections.research} />
        <EducationSection {...sections.education} />
      </main>
      <Sidebar sections={sections} className="sticky top-8 mt-0 lg:mt-20" />
    </div>
    </div>
  </div>
  <script src="../web/scripts/initialize-tooltips.ts"></script>
</Layout>
